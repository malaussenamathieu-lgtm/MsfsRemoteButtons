<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64;AnyCPU</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <!-- Package pour le serveur HTTP/WebSocket -->
  <ItemGroup>
    <PackageReference Include="EmbedIO" Version="3.5.2" />
  </ItemGroup>

  <!-- 
    IMPORTANT: Tu dois copier 2 DLL dans le dossier du projet:
    1. Microsoft.FlightSimulator.SimConnect.dll (managed)
       Depuis: C:\MSFS 2024 SDK\SimConnect SDK\lib\managed\Microsoft.FlightSimulator.SimConnect.dll
    2. SimConnect.dll (native)
       Depuis: C:\MSFS 2024 SDK\SimConnect SDK\lib\SimConnect.dll
  -->
  <ItemGroup>
    <Reference Include="Microsoft.FlightSimulator.SimConnect">
      <HintPath>Microsoft.FlightSimulator.SimConnect.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Copie les DLL dans le dossier bin à la compilation -->
  <ItemGroup>
    <None Include=".github\copilot-instructions.md" />
    <None Include="Microsoft.FlightSimulator.SimConnect.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="SimConnect.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="YourProject.csproj" />
  </ItemGroup>

  <!-- Fichiers web embarqués -->
  <ItemGroup>
    <EmbeddedResource Include="Web\**\*" />
    <Content Include="Web\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
